# Same Supabase project as kleen-app / kleen-admin
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required on Vercel so the Add service dropdown can sync all catalogue rows to Supabase

# This app’s public URL (e.g. https://contractor.kleenapp.co.uk) — Stripe return URLs and OAuth
NEXT_PUBLIC_SITE_URL=http://localhost:3101

# Customer app (dashboard) for “Customer sign in” links and mistaken-role redirects
NEXT_PUBLIC_CUSTOMER_APP_URL=http://localhost:3100

# Marketing site (optional) — sign-out lands here; defaults to https://www.kleenapp.co.uk
NEXT_PUBLIC_MARKETING_URL=https://www.kleenapp.co.uk

# Optional: share auth cookies across *.kleenapp.co.uk (kleen-app / kleen-admin only)
# Do NOT set on kleen-contractor — contractor portal uses isolated auth cookies.
# NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=.kleenapp.co.uk

STRIPE_SECRET_KEY=

RESEND_API_KEY=
# Admin inbox for new contractor signup + review emails (default info@kleenapp.co.uk)
ADMIN_NOTIFY_EMAIL=info@kleenapp.co.uk
ADMIN_APP_URL=https://admin.kleenapp.co.uk
RESEND_FORCE_ONBOARDING=true
RESEND_FROM_VERIFIED=false
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=info@kleenapp.co.uk
